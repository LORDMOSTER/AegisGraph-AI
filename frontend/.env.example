# ==============================================================================
# AegisGraph AI — Frontend Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# Only variables prefixed with `VITE_` are exposed to the client-side JavaScript bundle.
# NEVER store backend database credentials, JWT secrets, or private API keys in this file.
# ==============================================================================

# API Backend Base URL (leave blank to default to current hostname on port 8000)
# Example: https://api.aegisgraph.internal/api
VITE_API_URL=

# Force HTTPS Client-Side Check (true/false)
VITE_FORCE_HTTPS=true
